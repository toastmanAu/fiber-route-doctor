{
  "name": "fiber-route-doctor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:core": "tsc -p packages/core/tsconfig.json --noEmit",
    "typecheck:cli": "tsc -p apps/cli/tsconfig.json --noEmit",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "typecheck:biscuit": "tsc -p packages/biscuit/tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:core && npm run typecheck:cli && npm run typecheck:web && npm run typecheck:biscuit",
    "smoke:live": "node --import tsx scripts/live-smoke.mjs",
    "smoke:biscuit": "node --import tsx scripts/biscuit-live-smoke.mjs",
    "smoke:channel": "node --import tsx scripts/channel-live-smoke.mjs",
    "smoke:health": "node --import tsx scripts/health-live-smoke.mjs",
    "smoke:liquidity": "node --import tsx scripts/liquidity-live-smoke.mjs",
    "smoke:map": "node --import tsx scripts/map-live-smoke.mjs",
    "smoke:wallet": "node --import tsx scripts/wallet-live-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
